    {
      "type": "http-request",
      "name": "Search parkings",
      "seq": 1,
      "request": {
        "url": "{{baseUrl}}/api/v1/parkings?lat={{lat}}&lon={{lon}}&radius={{radius}}",
        "method": "GET",
        "headers": [],
        "params": [
          {
            "name": "lat",
            "value": "{{lat}}",
            "type": "query",
            "enabled": true
          },
          {
            "name": "lon",
            "value": "{{lon}}",
            "type": "query",
            "enabled": true
          },
          {
            "name": "radius",
            "value": "{{radius}}",
            "type": "query",
            "enabled": true
          }
        ],
        "body": {
          "mode": "none"
        },
        "auth": {
          "mode": "none"
        },
        "script": {},
        "vars": {},
        "assertions": [
          {
            "name": "res.status",
            "value": "eq 200",
            "enabled": true
          },
          {
            "name": "res.body.parkings",
            "value": "isArray",
            "enabled": true
          }
        ],
        "tests": "test(\"sorted by distance, nearest first\", function () {\n  const d = res.body.parkings.map(p => p.distanceMeters);\n  expect(d).to.deep.equal([...d].sort((a, b) => a - b));\n});\ntest(\"every parking is within the radius\", function () {\n  res.body.parkings.forEach(p => expect(p.distanceMeters).to.be.at.most(Number(bru.getEnvVar(\"radius\"))));\n});\ntest(\"parkings follow the public contract\", function () {\n  res.body.parkings.forEach(p => {\n    expect(p).to.have.all.keys(\"name\", \"latitude\", \"longitude\", \"distanceMeters\", \"availableSpaces\", \"totalSpaces\");\n  });\n});",
        "docs": ""
      }
    },
